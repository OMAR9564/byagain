APP_NAME=byagain
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Interface language is English (spec FR-088). Keys live under lang/en/.
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database — MySQL 8 (Constitution art. II: the stack is fixed).
# The schema relies on composite UNIQUE indexes: (user_id, review_date),
# (review_id, position), (user_id, day), (user_id, dedupe_key).
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=byagain
DB_USERNAME=byagain
DB_PASSWORD=

# ---------------------------------------------------------------------------
# Session / cache / queue — all on the `database` driver so a single MySQL
# instance is the only infrastructure dependency (no Redis in the MVP).
# ---------------------------------------------------------------------------
# Reverse proxy addresses whose X-Forwarded-* headers may be believed.
# Loopback covers nginx on the same host. Without this, TLS terminating at the
# proxy makes every signed unsubscribe link fail its signature check, and every
# visitor appears to come from the proxy's own address.
# Use `*` only when the app cannot be reached except through the proxy.
TRUSTED_PROXIES=127.0.0.1,::1

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# The daily pipeline enqueues mail jobs; a worker must be running in production
# (`php artisan queue:work --queue=default`).
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# ---------------------------------------------------------------------------
# Mail — provider decision R-11: Resend (resend/resend-laravel).
# Local development uses the `log` mailer so no mail leaves the machine.
# Staging/production: MAIL_MAILER=resend and set RESEND_API_KEY.
# SPF/DKIM/DMARC for MAIL_FROM_ADDRESS's domain are a go-live prerequisite.
# ---------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@byagain.test"
MAIL_FROM_NAME="${APP_NAME}"

RESEND_API_KEY=
# Shared secret used to verify the Resend webhook signature that marks a
# delivery as opened (FR-064). Leave empty to reject every webhook call.
RESEND_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Browser notifications — VAPID (FR-141…FR-153).
#
# Generate a pair with `php artisan byagain:vapid-keys` and paste the output
# here by hand. The command prints and writes nothing.
#
# Leave these empty and the feature is simply off: the subscription endpoint
# answers 503 and the settings toggle renders disabled. Nothing else changes.
#
# Do not rotate them casually — every subscription a reader has granted is
# tied to the public key it was created with, and a new pair silently orphans
# all of them.
# ---------------------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Who to contact about this server's notifications: a mailto: or https: URL.
VAPID_SUBJECT="mailto:hello@byagain.test"

VITE_APP_NAME="${APP_NAME}"
